use std::str::FromStr;

grammar;

pub Expr: i64 = {
    <l:Expr> "+" <r:Factor> => l + r,
    <l:Expr> "-" <r:Factor> => l - r,
    Factor,
};

Factor: i64 = {
    <l:Factor> "*" <r:Term> => l * r,
    <l:Factor> "/" <r:Term> => l / r,
    Term,
};

Term: i64 = {
    Num,
    "(" <Expr> ")",
};

Num: i64 = <s:r"[0-9]+"> => i64::from_str(s).unwrap();