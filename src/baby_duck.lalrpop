use crate::lexer::Token;
use crate::cubo_semantico::{Operador, Tipo, TipoRetorno, ErrorUsuario, error_en};
use crate::directorio::DirFunciones;
use crate::cuadruplos::GeneradorCuadruplos; 

grammar(dir: &mut DirFunciones, generador: &mut GeneradorCuadruplos);

// ponemos extern para que lalrpop no genere lexico sino tome el que creamos en lexer.rs
extern {
    type Location = usize;          // las posiciones son los índices en el texto
    type Error = ErrorUsuario;      // errores del scanner (Lexico) o de las acciones (Semantico)

    enum Token {
        // palabras reservadas
        "program" => Token::Program,
        "main"    => Token::Main,
        "end"     => Token::End,
        "var"     => Token::Var,
        "int"     => Token::Int,
        "float"   => Token::Float,
        "void"    => Token::Void,
        "print"   => Token::Print,
        "read"    => Token::Read,
        "while"   => Token::While,
        "do"      => Token::Do,
        "if"      => Token::If,
        "else"    => Token::Else,
        "return" => Token::Return,
        // operadores
        "="  => Token::Asignar,
        "+"  => Token::Mas,
        "-"  => Token::Menos,
        "*"  => Token::Por,
        "/"  => Token::Entre,
        ">"  => Token::Mayor,
        "<"  => Token::Menor,
        "!=" => Token::Diferente,
        // delimitadores
        ";" => Token::PuntoComa,
        "," => Token::Coma,
        ":" => Token::DosPuntos,
        "(" => Token::ParIzq,
        ")" => Token::ParDer,
        "{" => Token::LlaveIzq,
        "}" => Token::LlaveDer,
        "[" => Token::CorIzq,
        "]" => Token::CorDer,
        // tokens con valor: <Tipo> indica el dato que viene dentro
        "id"         => Token::Id(<String>),
        "cte_int"    => Token::CteInt(<i64>),
        "cte_float"  => Token::CteFloat(<f64>),
        "cte_string" => Token::CteString(<String>),
    }
}

// Gramatica

// <Programa> → program id ; <VarsOpt> <ListaFuncs> main <Body> end
pub Programa: () = {
    EncabezadoPrograma VarsOpt ListaFuncs "main" Body "end" => (),
};
// Separamos la regla ya que al leer 'program nombre ;' debemos crear el Directorio con el alcance global.
EncabezadoPrograma: () = {
    "program" <nombre:"id"> ";" => { *dir = DirFunciones::nuevo(&nombre); },
};

// ======================= Variables =======================

// <VarsOpt> → <Vars> | ε
VarsOpt: () = {
    Vars => (),
    => (),
};

// <Vars> → var <ListaDecl>
Vars: () = {
    "var" ListaDecl => (),
};

// <ListaDecl> → <ListaDecl> <Decl> | <Decl>
ListaDecl: () = {
    ListaDecl Decl => (),
    Decl => (),
};

Decl: () = {
    <ids:ListaIds> ":" <t:Type> ";" =>? {
        for (pos, nombre) in ids {
            dir.agregar_variable(&nombre, t).map_err(|m| error_en(pos, m))?;
        }
        Ok(())
    },
};

// <ListaIds> → <ListaIds> , id | id
ListaIds: Vec<(usize, String)> = {
    <mut lista:ListaIds> "," <pos:@L> <nombre:"id"> => { lista.push((pos, nombre)); lista },
    <pos:@L> <nombre:"id"> => vec![(pos, nombre)],
};

// <Type> → int | float
Type: Tipo = {
    "int" => Tipo::Int,
    "float" => Tipo::Float,
};

// ======================= Funciones =======================

// <ListaFuncs> → <ListaFuncs> <Funcs> | ε
ListaFuncs: () = {
    ListaFuncs Funcs => (),
    => (),
};

// <Funcs> → <TipoFunc> id ( <ParamsOpt> ) [ <VarsOpt> <Body> ] ;
Funcs: () = {
    EncabezadoFunc "(" ParamsOpt ")" "[" VarsOpt Body "]" ";" => dir.salir_funcion(),
};
// Separamos la regla ya que la función se registra antes de leer sus parámetros y su cuerpo.
EncabezadoFunc: () = {
    <t:TipoFunc> <pos:@L> <nombre:"id"> =>? dir.agregar_funcion(&nombre, t).map_err(|m| error_en(pos, m)),
};

// <TipoFunc> → void | <Type>
TipoFunc: TipoRetorno = {
    "void" => TipoRetorno::Void,
    <t:Type> => TipoRetorno::Valor(t),
};

// <ParamsOpt> → <ListaParams> | ε
ParamsOpt: () = {
    ListaParams => (),
    => (),
};

// <ListaParams> → <ListaParams> , <Param> | <Param>
ListaParams: () = {
    ListaParams "," Param => (),
    Param => (),
};

// <Param> → id : <Type>
Param: () = {
    <pos:@L> <nombre:"id"> ":" <t:Type> =>? dir.agregar_parametro(&nombre, t).map_err(|m| error_en(pos, m)),
};

// ======================= Cuerpo y estatutos =======================

// <Body> → { <ListaStmt> }
Body: () = {
    "{" ListaStmt "}" => (),
};

// <ListaStmt> → <ListaStmt> <Statement> | ε
ListaStmt: () = {
    ListaStmt Statement => (),
    => (),
};

// <Statement> → <Assign> | <Condition> | <Cycle> | <FCall> | <Print> | <Read>
//             | [ <ListaStmt> ]
Statement: () = {
    Return => (),
    Assign => (),
    Condition => (),
    Cycle => (),
    FCall => (),
    Print => (),
    Read => (),
    "[" ListaStmt "]" => (),
};

// <Return> → return <Expresion> ;
Return: () = {
    <pos:@L> "return" Expresion ";" =>? {
        let tipo_funcion = dir.retorno_actual().map_err(|m| error_en(pos, m))?;
        generador.generar_return(tipo_funcion, pos)
    },
};

// <Assign> → id = <Expresion> ;
Assign: () = {
    <pos:@L> <nombre:"id"> "=" Expresion ";" =>? {
        let destino = dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.generar_asignacion(nombre, destino, pos)
    },
};

// <Condition> → if ( <Expresion> ) <Statement> <ElseOpt> ;
Condition: () = {
    "if" "(" Expresion ")" Statement ElseOpt ";" => (),
};

// <ElseOpt> → else <Statement> | ε
ElseOpt: () = {
    "else" Statement => (),
    => (),
};

// <Cycle> → while ( <Expresion> ) do <Statement> ;
Cycle: () = {
    "while" "(" Expresion ")" "do" Statement ";" => (),
};

// <Print> → print ( <ListaPrint> ) ;
Print: () = {
    "print" "(" ListaPrint ")" ";" => (),
};

// <ListaPrint> → <ListaPrint> , <ElemPrint> | <ElemPrint>
ListaPrint: () = {
    ListaPrint "," ElemPrint => (),
    ElemPrint => (),
};

// <ElemPrint> → <Expresion> | cte_string
ElemPrint: () = {
    Expresion => generador.generar_print_expresion(),
    <texto:"cte_string"> => generador.generar_print_texto(texto),
};

// <Read> → read ( id ) ;
Read: () = {
    "read" "(" <pos:@L> <nombre:"id"> ")" ";" =>? {
        dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.generar_read(nombre);
        Ok(())
    },
};

// <FCall> → <Llamada> ;          (llamada usada como estatuto)
FCall: () = {
    Llamada ";" => (),
};

// <Llamada> → id ( <ArgsOpt> )    (llamada usada dentro de una expresión)
Llamada: (String, TipoRetorno) = {
    <pos:@L> <nombre:"id"> "(" ArgsOpt ")" =>? {
        let tipo = dir.buscar_funcion(&nombre).map_err(|m| error_en(pos, m))?.tipo_retorno;
        Ok((nombre, tipo))
    },
};

// <ArgsOpt> → <ListaArgs> | ε
ArgsOpt: () = {
    ListaArgs => (),
    => (),
};

// <ListaArgs> → <ListaArgs> , <Expresion> | <Expresion>
ListaArgs: () = {
    ListaArgs "," Expresion => (),
    Expresion => (),
};

// ======================= Expresiones =======================

Expresion: Tipo = {
    Exp,
    <pos:@L> Exp OpRel Exp =>? generador.generar_operacion(pos),
};

Exp: Tipo = {
    <pos:@L> Exp OpSuma Termino =>? generador.generar_operacion(pos),
    Termino,
};

Termino: Tipo = {
    <pos:@L> Termino OpMult Factor =>? generador.generar_operacion(pos),
    Factor,
};

Factor: Tipo = {
    "(" <Expresion> ")",
    "+" <Atomo>,
    <pos:@L> "-" Atomo =>? generador.generar_negativo(pos),
    Atomo,
    <pos:@L> <llamada:Llamada> =>? match llamada {
        (nombre, TipoRetorno::Valor(t)) => { generador.meter_operando(nombre, t); Ok(t) },
        (_, TipoRetorno::Void) => Err(error_en(pos, "una función void no regresa valor; no se puede usar en una expresión".to_string())),
    },
};

Atomo: Tipo = {
    <pos:@L> <nombre:"id"> =>? {
        let tipo = dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.meter_operando(nombre, tipo);
        Ok(tipo)
    },
    Cte,
};

Cte: Tipo = {
    <valor:"cte_int"> => { generador.meter_operando(valor.to_string(), Tipo::Int); Tipo::Int },
    <valor:"cte_float"> => { generador.meter_operando(valor.to_string(), Tipo::Float); Tipo::Float },
};


// ======================= Reglas Operadores =======================

OpRel: () = {
    ">" => generador.meter_operador(Operador::Mayor),
    "<" => generador.meter_operador(Operador::Menor),
    "!=" => generador.meter_operador(Operador::Diferente),
};

OpSuma: () = {
    "+" => generador.meter_operador(Operador::Suma),
    "-" => generador.meter_operador(Operador::Resta),
};

OpMult: () = {
    "*" => generador.meter_operador(Operador::Mult),
    "/" => generador.meter_operador(Operador::Div),
};