use crate::lexer::Token;
use crate::cubo_semantico::{Operador, Tipo, TipoRetorno, ErrorUsuario, error_en};
use crate::directorio::DirFunciones;
use crate::cuadruplos::GeneradorCuadruplos; 

grammar(dir: &mut DirFunciones, generador: &mut GeneradorCuadruplos);

// ponemos extern para que lalrpop no genere lexico sino tome el que creamos en lexer.rs
extern {
    type Location = usize;          // las posiciones son los índices en el texto
    type Error = ErrorUsuario;      // errores del scanner (Lexico) o de las acciones (Semantico)

    enum Token {
        // palabras reservadas
        "program" => Token::Program,
        "main"    => Token::Main,
        "end"     => Token::End,
        "var"     => Token::Var,
        "int"     => Token::Int,
        "float"   => Token::Float,
        "void"    => Token::Void,
        "print"   => Token::Print,
        "read"    => Token::Read,
        "while"   => Token::While,
        "do"      => Token::Do,
        "if"      => Token::If,
        "else"    => Token::Else,
        "return" => Token::Return,
        // operadores
        "="  => Token::Asignar,
        "+"  => Token::Mas,
        "-"  => Token::Menos,
        "*"  => Token::Por,
        "/"  => Token::Entre,
        ">"  => Token::Mayor,
        "<"  => Token::Menor,
        "!=" => Token::Diferente,
        // delimitadores
        ";" => Token::PuntoComa,
        "," => Token::Coma,
        ":" => Token::DosPuntos,
        "(" => Token::ParIzq,
        ")" => Token::ParDer,
        "{" => Token::LlaveIzq,
        "}" => Token::LlaveDer,
        "[" => Token::CorIzq,
        "]" => Token::CorDer,
        // tokens con valor: <Tipo> indica el dato que viene dentro
        "id"         => Token::Id(<String>),
        "cte_int"    => Token::CteInt(<i64>),
        "cte_float"  => Token::CteFloat(<f64>),
        "cte_string" => Token::CteString(<String>),
    }
}

// Gramatica

// <Programa> → program id ; <VarsOpt> <ListaFuncs> main <Body> end
pub Programa: () = {
    EncabezadoPrograma VarsOpt ListaFuncs InicioMain Body "end" => {
        dir.funcion_actual_mut().recursos = generador.memoria.recursos(); // temporales que usó main
        generador.generar_end();
    },
};
// Separamos la regla ya que al leer 'program nombre ;' debemos crear el Directorio con el alcance global
// y generar el GOTO a main (el primer cuádruplo).
EncabezadoPrograma: () = {
    "program" <nombre:"id"> ";" => {
        *dir = DirFunciones::nuevo(&nombre);
        generador.generar_goto_main();
    },
};
// Separamos la regla para rellenar el GOTO del inicio justo antes del código de main.
InicioMain: () = {
    "main" => {
        generador.rellenar_goto_main();
        dir.funcion_actual_mut().inicio = generador.siguiente(); // main empieza aquí
    },
};

// ======================= Variables =======================

// <VarsOpt> → <Vars> | ε
VarsOpt: () = {
    Vars => (),
    => (),
};

// <Vars> → var <ListaDecl>
Vars: () = {
    "var" ListaDecl => (),
};

// <ListaDecl> → <ListaDecl> <Decl> | <Decl>
ListaDecl: () = {
    ListaDecl Decl => (),
    Decl => (),
};

Decl: () = {
    <ids:ListaIds> ":" <t:Type> ";" =>? {
        for (pos, nombre) in ids {
            dir.agregar_variable(&nombre, t, &mut generador.memoria).map_err(|m| error_en(pos, m))?;
        }
        Ok(())
    },
};

// <ListaIds> → <ListaIds> , id | id
ListaIds: Vec<(usize, String)> = {
    <mut lista:ListaIds> "," <pos:@L> <nombre:"id"> => { lista.push((pos, nombre)); lista },
    <pos:@L> <nombre:"id"> => vec![(pos, nombre)],
};

// <Type> → int | float
Type: Tipo = {
    "int" => Tipo::Int,
    "float" => Tipo::Float,
};

// ======================= Funciones =======================

// <ListaFuncs> → <ListaFuncs> <Funcs> | ε
ListaFuncs: () = {
    ListaFuncs Funcs => (),
    => (),
};

// <Funcs> → <TipoFunc> id ( <ParamsOpt> ) [ <VarsOpt> <Body> ] ;
Funcs: () = {
    EncabezadoFunc "(" ParamsOpt ")" "[" VarsOpt Body "]" ";" => {
        generador.generar_endfunc();
        dir.funcion_actual_mut().recursos = generador.memoria.recursos(); // su tamaño para el ERA
        dir.salir_funcion();
        generador.memoria.reiniciar_locales(); // main empieza con sus temporales desde 5000/6000/7000
    },
};
// Separamos la regla ya que la función se registra antes de leer sus parámetros y su cuerpo.
EncabezadoFunc: () = {
    <t:TipoFunc> <pos:@L> <nombre:"id"> =>? {
        generador.memoria.reiniciar_locales(); // la función nueva empieza sus locales desde 3000/4000
        dir.agregar_funcion(&nombre, t, &mut generador.memoria).map_err(|m| error_en(pos, m))?;
        // Los parámetros y las variables no generan cuádruplos, así que su código empieza en el siguiente.
        dir.funcion_actual_mut().inicio = generador.siguiente();
        Ok(())
    },
};

// <TipoFunc> → void | <Type>
TipoFunc: TipoRetorno = {
    "void" => TipoRetorno::Void,
    <t:Type> => TipoRetorno::Valor(t),
};

// <ParamsOpt> → <ListaParams> | ε
ParamsOpt: () = {
    ListaParams => (),
    => (),
};

// <ListaParams> → <ListaParams> , <Param> | <Param>
ListaParams: () = {
    ListaParams "," Param => (),
    Param => (),
};

// <Param> → id : <Type>
Param: () = {
    <pos:@L> <nombre:"id"> ":" <t:Type> =>? dir.agregar_parametro(&nombre, t, &mut generador.memoria).map_err(|m| error_en(pos, m)),
};

// ======================= Cuerpo y estatutos =======================

// <Body> → { <ListaStmt> }
Body: () = {
    "{" ListaStmt "}" => (),
};

// <ListaStmt> → <ListaStmt> <Statement> | ε
ListaStmt: () = {
    ListaStmt Statement => (),
    => (),
};

// <Statement> → <Assign> | <Condition> | <Cycle> | <FCall> | <Print> | <Read>
//             | [ <ListaStmt> ]
Statement: () = {
    Return => (),
    Assign => (),
    Condition => (),
    Cycle => (),
    FCall => (),
    Print => (),
    Read => (),
    "[" ListaStmt "]" => (),
};

// <Return> → return <Expresion> ;
Return: () = {
    <pos:@L> "return" Expresion ";" =>? {
        let (tipo_funcion, direccion_retorno) = dir.retorno_actual().map_err(|m| error_en(pos, m))?;
        generador.generar_return(tipo_funcion, direccion_retorno, pos)
    },
};

// <Assign> → id = <Expresion> ;
Assign: () = {
    <pos:@L> <nombre:"id"> "=" Expresion ";" =>? {
        let destino = dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.generar_asignacion(destino.direccion, destino.tipo, pos)
    },
};

// <Condition> → if ( <Expresion> ) <Statement> <ElseOpt> ;
// Al terminar todo el if se rellena el salto pendiente.
Condition: () = {
    CondicionIf Statement ElseOpt ";" => generador.generar_fin_if(),
};

// Separamos la regla para generar el GOTOF justo después de la condición, antes del Statement.
CondicionIf: () = {
    "if" "(" <pos:@L> Expresion ")" =>? generador.generar_gotof(pos),
};

// <ElseOpt> → else <Statement> | ε
ElseOpt: () = {
    InicioElse Statement => (),
    => (),
};

// Separamos la regla para generar el GOTO al leer else, antes del Statement del else.
InicioElse: () = {
    "else" => generador.generar_else(),
};

// <Cycle> → while ( <Expresion> ) do <Statement> ;
// Al terminar el ciclo se genera el GOTO de regreso y se rellena el GOTOF.
Cycle: () = {
    InicioWhile CondicionWhile "do" Statement ";" => generador.generar_fin_while(),
};

// Separamos la regla para guardar el punto de regreso ANTES de generar la condición.
InicioWhile: () = {
    "while" => generador.generar_inicio_while(),
};

// Separamos la regla para generar el GOTOF justo después de la condición.
CondicionWhile: () = {
    "(" <pos:@L> Expresion ")" =>? generador.generar_gotof(pos),
};

// <Print> → print ( <ListaPrint> ) ;
Print: () = {
    "print" "(" ListaPrint ")" ";" => (),
};

// <ListaPrint> → <ListaPrint> , <ElemPrint> | <ElemPrint>
ListaPrint: () = {
    ListaPrint "," ElemPrint => (),
    ElemPrint => (),
};

// <ElemPrint> → <Expresion> | cte_string
ElemPrint: () = {
    Expresion => generador.generar_print_expresion(),
    <pos:@L> <texto:"cte_string"> =>? generador.generar_print_texto(texto, pos),
};

// <Read> → read ( id ) ;
Read: () = {
    "read" "(" <pos:@L> <nombre:"id"> ")" ";" =>? {
        let variable = dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.generar_read(variable.direccion);
        Ok(())
    },
};

// <FCall> → <Llamada> ;          (llamada usada como estatuto)
FCall: () = {
    Llamada ";" => (),
};

// <Llamada> → id ( <ArgsOpt> )    (llamada usada dentro de una expresión)
// Al cerrar ")" se genera el GOSUB. Regresa la dirección global donde la función
// deja su valor y su tipo (None si es void).
Llamada: Option<(usize, Tipo)> = {
    <inicio:InicioLlamada> ArgsOpt <pos:@L> ")" =>? {
        generador.generar_gosub(pos)?;
        Ok(inicio)
    },
};

// Separamos la regla para generar el ERA al leer "id (", ANTES de traducir los argumentos.
InicioLlamada: Option<(usize, Tipo)> = {
    <pos:@L> <nombre:"id"> "(" =>? {
        let funcion = dir.buscar_funcion(&nombre).map_err(|m| error_en(pos, m))?;
        let retorno = match (funcion.tipo_retorno, funcion.direccion_retorno) {
            (TipoRetorno::Valor(t), Some(direccion)) => Some((direccion, t)),
            _ => None, // void
        };
        generador.generar_era(nombre, funcion.inicio, funcion.parametros.clone());
        Ok(retorno)
    },
};

// <ArgsOpt> → <ListaArgs> | ε
ArgsOpt: () = {
    ListaArgs => (),
    => (),
};

// <ListaArgs> → <ListaArgs> , <Argumento> | <Argumento>
ListaArgs: () = {
    ListaArgs "," Argumento => (),
    Argumento => (),
};

// Cada argumento: al terminar su expresión se genera su PARAM.
Argumento: () = {
    <pos:@L> Expresion =>? generador.generar_param(pos),
};

// ======================= Expresiones =======================

Expresion: Tipo = {
    Exp,
    <pos:@L> Exp OpRel Exp =>? generador.generar_operacion(pos),
};

Exp: Tipo = {
    <pos:@L> Exp OpSuma Termino =>? generador.generar_operacion(pos),
    Termino,
};

Termino: Tipo = {
    <pos:@L> Termino OpMult Factor =>? generador.generar_operacion(pos),
    Factor,
};

Factor: Tipo = {
    "(" <Expresion> ")",
    "+" <Atomo>,
    <pos:@L> "-" Atomo =>? generador.generar_negativo(pos),
    Atomo,
    <pos:@L> <llamada:Llamada> =>? match llamada {
        Some((direccion, t)) => generador.generar_copia_retorno(direccion, t, pos),
        None => Err(error_en(pos, "una función void no regresa valor; no se puede usar en una expresión".to_string())),
    },
};

Atomo: Tipo = {
    <pos:@L> <nombre:"id"> =>? {
        let variable = dir.buscar_variable(&nombre).map_err(|m| error_en(pos, m))?;
        generador.meter_operando(variable.direccion, variable.tipo);
        Ok(variable.tipo)
    },
    Cte,
};

Cte: Tipo = {
    <pos:@L> <valor:"cte_int"> =>? {
        let direccion = generador.memoria.constante_int(valor).map_err(|m| error_en(pos, m))?;
        generador.meter_operando(direccion, Tipo::Int);
        Ok(Tipo::Int)
    },
    <pos:@L> <valor:"cte_float"> =>? {
        let direccion = generador.memoria.constante_float(valor).map_err(|m| error_en(pos, m))?;
        generador.meter_operando(direccion, Tipo::Float);
        Ok(Tipo::Float)
    },
};


// ======================= Reglas Operadores =======================

OpRel: () = {
    ">" => generador.meter_operador(Operador::Mayor),
    "<" => generador.meter_operador(Operador::Menor),
    "!=" => generador.meter_operador(Operador::Diferente),
};

OpSuma: () = {
    "+" => generador.meter_operador(Operador::Suma),
    "-" => generador.meter_operador(Operador::Resta),
};

OpMult: () = {
    "*" => generador.meter_operador(Operador::Mult),
    "/" => generador.meter_operador(Operador::Div),
};